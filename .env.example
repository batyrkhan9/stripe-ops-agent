# Copy to .env.local and fill in. Test mode only. Never put a live key in any env file.

# Postgres on Neon
DATABASE_URL=

# Stripe write key. Used only by `pnpm seed`. Never set this in Vercel.
# The seed script refuses to run if this equals STRIPE_DEMO_KEY or is not a test key.
STRIPE_SEED_KEY=sk_test_xxx

# Stripe read-only restricted key for the seeded demo account. Used by demo mode on the server.
STRIPE_DEMO_KEY=rk_test_xxx

# Webhook signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Connect OAuth (read_only scope)
STRIPE_CONNECT_CLIENT_ID=ca_xxx
STRIPE_PLATFORM_KEY=rk_test_xxx

# LLM providers (free tiers)
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# Morning brief email (Resend free tier)
RESEND_API_KEY=
BRIEF_FROM_EMAIL=

# Shared secret Vercel Cron sends in the Authorization header
CRON_SECRET=

# Public base URL, used for OAuth redirect and email links
APP_URL=http://localhost:3000
